# LibraryEase Environment Configuration — Template

# Database Configuration (MySQL)
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=libraryease

# Or specify a full connection string:
# MySQL: mysql+pymysql://root:your_mysql_password_here@127.0.0.1:3307/libraryease
# SQLite: sqlite:///./libraryease.db
DATABASE_URL=mysql+pymysql://root:your_mysql_password_here@127.0.0.1:3307/libraryease

# Security & Authentication (Required for Production)
# Generate a cryptographically strong 64-character secret using: openssl rand -hex 32
JWT_SECRET=your_secure_random_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Configuration (Optional: comma-separated list of additional production origins)
# Example: CORS_ORIGINS=https://your-domain.com,https://app.your-domain.com
CORS_ORIGINS=

# AI Configuration (Optional: Gemini API)
GEMINI_API_KEY=

# Library Information
LIBRARY_NAME=LibraryEase Central Public Library
LIBRARY_TIMEZONE=Asia/Kolkata

# SMTP Email Configuration (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SENDER_EMAIL=reminders@libraryease.org
