# =====================================================================
# LibraryEase Monorepo Environment Variables Reference Template
# For Vercel Multi-Service Deployment
# Note: In Vercel, set these in Project Settings -> Environment Variables
# =====================================================================

# ----------------- Frontend Service -----------------
# For Vercel Multi-Service (same domain), /api routes directly to backend service
VITE_API_BASE_URL=/api

# ----------------- Backend Service -----------------
# Security & JWT Authentication (REQUIRED for Production)
# Generate a cryptographically strong 64-character secret (e.g. openssl rand -hex 32)
JWT_SECRET=your_secure_random_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Google Gemini AI Integration (Required for AI Book Search & Assistant)
GEMINI_API_KEY=your_gemini_api_key_here

# Database Configuration (Optional: defaults to /tmp/libraryease.db on Vercel serverless)
# For persistent storage across cold starts, connect an external managed MySQL or PostgreSQL database:
# DATABASE_URL=mysql+pymysql://username:password@remote-host:3306/libraryease
DATABASE_URL=

# CORS Configuration (Optional: Vercel preview/production domains are automatically trusted)
# Example: https://custom-domain.com,https://staging.custom-domain.com
CORS_ORIGINS=

# Civic Library Metadata
LIBRARY_NAME=LibraryEase Central Public Library
LIBRARY_TIMEZONE=Asia/Kolkata

# SMTP Notification Dispatch (Optional: emails are simulated & logged if omitted)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SENDER_EMAIL=reminders@libraryease.org
